{
  "name": "streamr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Stateless bounded-memory stream gateway and MCP server for Cloudflare Workers",
  "scripts": {
    "postinstall": "patch-package && npm run generate:xz-wasm",
    "generate:xz-wasm": "node scripts/extract-xz-wasm.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check:types": "wrangler types --check && tsc --noEmit",
    "lint": "oxlint --deny-warnings src test vitest.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "check": "npm run check:types && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@openpgp/unbzip2-stream": "2.0.0",
    "agents": "0.21.0",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "modern-tar": "0.8.4",
    "xz-decompress": "0.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@types/node": "24.10.1",
    "oxlint": "1.80.0",
    "patch-package": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  },
  "engines": {
    "node": ">=24"
  }
}
