{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stateless-stream-gateway-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 20000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
